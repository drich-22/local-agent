# Copy to ~/.local/share/open-webui/local-agent.env (setup script writes this).
# Never commit real secrets.env or local-agent.env.

WEBUI_AUTH=true
ENABLE_SIGNUP=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_MESSAGE_RATING=false
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Generate once: openssl rand -hex 32 → secrets.env as WEBUI_SECRET_KEY=...
WEBUI_SECRET_KEY=

# Bind (start.sh): BIND_HOST=127.0.0.1 default; Tailscale requires ALLOW_LAN=1
# BIND_HOST=127.0.0.1
# ALLOW_LAN=0

# Reduce SSRF via redirect chains (Open WebUI 0.9.6+)
AIOHTTP_CLIENT_SESSION_REDIRECT=false

# Optional: restrict web fetch (see Open WebUI docs WEB_FETCH / filter lists)
# WEB_FETCH_FILTER_LIST=
