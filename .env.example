# Copy to .env for local overrides (never commit .env)

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_LENGTH=16384
PRIMARY_MODEL=qwen3.6:27b
FAST_MODEL=qwen2.5-coder:7b
CHAT_ALIAS=local-chat

# Network — default localhost-only
BIND_HOST=127.0.0.1
ALLOW_LAN=0
# Tailscale: ALLOW_LAN=1 and BIND_HOST=0.0.0.0 (see docs/HARDENING.md)

# Open WebUI
WEBUI_PORT=8080
OPEN_WEBUI_PYTHON=3.11

# Updates
UPDATE_BRANCH=main
UPDATE_REMOTE=origin
# UPDATE_AUTO_YES=1
# UPDATE_ALLOW_DIRTY=0
